generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId      Int      @id @default(autoincrement()) @map("user_id")
  username    String   @unique @db.VarChar(100)
  password    String   @db.VarChar(255) // bcrypt hash
  role        String   @default("staff") @db.VarChar(50)
  memberRefId Int?     @map("member_ref_id")
  member      Member?  @relation(fields: [memberRefId], references: [id])

  @@map("users")
}

model Member {
  id           Int           @id @default(autoincrement())
  memberId     String        @unique @map("member_id") @db.VarChar(50)
  name         String        @db.VarChar(150)
  email        String        @db.VarChar(150)
  phone        String?       @db.VarChar(50)
  address      String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  users        User[]
  borrowings   Borrowing[]
  reservations Reservation[]

  @@map("members")
}

model Book {
  bookId       Int           @id @default(autoincrement()) @map("book_id")
  title        String        @db.VarChar(255)
  author       String?       @db.VarChar(255)
  category     String?       @db.VarChar(150)
  isbn         String?       @db.VarChar(50)
  coverUrl     String?       @map("cover_url") @db.VarChar(500)
  quantity     Int           @default(1)
  borrowings   Borrowing[]
  reservations Reservation[]

  @@map("books")
}

model Settings {
  id              Int     @id @default(1)
  loanPeriodDays  Int     @default(14) @map("loan_period_days")
  maxLoanPeriodDays Int   @default(30) @map("max_loan_period_days")
  finePerDay      Int     @default(20) @map("fine_per_day")

  @@map("settings")
}

model Borrowing {
  id         Int       @id @default(autoincrement())
  bookId     Int       @map("book_id")
  memberId   Int       @map("member_id")
  borrowDate DateTime  @default(now()) @map("borrow_date")
  dueDate    DateTime  @map("due_date") @db.Date
  returnDate DateTime? @map("return_date")
  status     String    @default("borrowed") @db.VarChar(20)
  fineAmount Decimal   @default(0) @map("fine_amount") @db.Decimal(8, 2)
  book       Book      @relation(fields: [bookId], references: [bookId])
  member     Member    @relation(fields: [memberId], references: [id])

  @@index([bookId])
  @@index([memberId])
  @@map("borrowings")
}

model Reservation {
  id         Int       @id @default(autoincrement())
  bookId     Int       @map("book_id")
  memberId   Int       @map("member_id")
  reservedAt DateTime  @default(now()) @map("reserved_at")
  status     String    @default("pending") // pending | ready | fulfilled | cancelled | expired
  notifiedAt DateTime? @map("notified_at")
  book       Book      @relation(fields: [bookId], references: [bookId])
  member     Member    @relation(fields: [memberId], references: [id])

  @@index([bookId])
  @@index([memberId])
  @@map("reservations")
}
